# =====================================================
# 스마트 제조 AI Agent — Git 추적 제외
# =====================================================

# --- 시크릿·환경 변수 (절대 커밋 금지) ---
.env
.env.local
.env.*.local
**/*api*key*
**/secrets/
*.pem
*.key

# --- 제조 데이터 (민감 가능성) ---
# data/raw/ 폴더 골격은 repo에 유지(.gitkeep), 원본 데이터 파일만 git 추적 제외
data/raw/*.pdf
data/raw/*.csv
!data/raw/.gitkeep
data/private/
*.csv.private

# --- 실험 결과 출력물 ---
# experiments 결과 출력물 (매뉴얼 원문 포함 가능, 재생성 가능한 파생물)
experiments/**/result_*.txt

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Vector DB 로컬 저장소 ---
chroma_db/
*.faiss
*.index
.chromadb/
qdrant_storage/
chroma_test_db/          # A7 검증 스크립트 테스트 DB (재생성·자동 삭제 대상)

# --- LangChain/LangGraph 캐시 ---
.langchain/
.langgraph/

# --- 로그·임시 ---
*.log
*.tmp
logs/

# --- IDE ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
